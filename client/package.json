{
  "name": "meditor-desktop",
  "private": true,
  "version": "0.1.9",
  "type": "module",
  "description": "MEditor — 基于 @meditor/editor 的 Markdown 桌面编辑器（Tauri + Rust）",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "sync:meditor": "node scripts/sync-vendor.mjs",
    "bump-version": "node scripts/bump-version.mjs",
    "package": "npm run bump-version && tauri build",
    "tauri": "tauri"
  },
  "dependencies": {
    "@milkdown/core": "^7.22.1",
    "@milkdown/ctx": "^7.22.1",
    "@milkdown/exception": "^7.22.1",
    "@milkdown/kit": "^7.22.1",
    "@milkdown/plugin-clipboard": "^7.22.1",
    "@milkdown/plugin-history": "^7.22.1",
    "@milkdown/plugin-indent": "^7.22.1",
    "@milkdown/plugin-listener": "^7.22.1",
    "@milkdown/plugin-tooltip": "^7.22.1",
    "@milkdown/preset-commonmark": "^7.22.1",
    "@milkdown/preset-gfm": "^7.22.1",
    "@milkdown/prose": "^7.22.1",
    "@milkdown/transformer": "^7.22.1",
    "@milkdown/utils": "^7.22.1",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "clsx": "^2.1.1",
    "i18next": "^23.16.8",
    "katex": "^0.16.47",
    "mermaid": "^12.1.0",
    "prosemirror-search": "^1.1.1",
    "refractor": "^4.9.0",
    "remark-footnotes": "^4.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^2.6.1",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^26.5.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}

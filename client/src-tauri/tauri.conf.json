{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MEditor",
  "version": "0.1.9",
  "identifier": "com.meditor.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5183",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "MEditor",
        "label": "main",
        "width": 1280,
        "height": 900,
        "minWidth": 640,
        "minHeight": 420,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": {
        "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:*; frame-src http://localhost:* http://127.0.0.1:*"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdx"
        ],
        "name": "Markdown 文档",
        "description": "Markdown 文本文档(MEditor)",
        "role": "Editor",
        "rank": "Default"
      }
    ]
  }
}
